# ===================================================================
# ApnaWallet Backend Environment Configuration Template
# Copy this file to 'backend/.env' and replace placeholders
# DO NOT COMMIT YOUR REAL .env FILE TO GIT
# ===================================================================

# Security
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Frontend URL (Used for generating Password Reset email links)
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------------
# Database: Neon PostgreSQL
# -------------------------------------------------------------------
# Option A (Recommended): Neon Full Connection URI (with SSL required)
# Copy directly from Neon Dashboard -> Connection Details
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual database variables (if preferred)
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=YOUR_NEON_PASSWORD
# DB_HOST=ep-sample-pooler.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_SSLMODE=require

# -------------------------------------------------------------------
# Transactional Email: Brevo (formerly Sendinblue)
# -------------------------------------------------------------------
# Obtain from Brevo Dashboard -> Settings -> SMTP & API -> Generate SMTP Key
BREVO_SMTP_KEY=your_brevo_smtp_master_key_here
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_brevo_login_email@example.com
DEFAULT_FROM_EMAIL=ApnaWallet <no-reply@apnawallet.com>

# Note: If BREVO_SMTP_KEY is left unset, Django automatically falls back
# to the Development Console Email Backend, printing all password reset emails
# directly to the Django server terminal window for effortless local testing.
